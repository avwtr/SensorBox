{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sensor Box",
  "version": "0.1.0",
  "identifier": "com.sensorbox.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sensor Box",
        "width": 960,
        "height": 820,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Environmental monitor for EE Sensor Box",
    "longDescription": "Connect to your EE Sensor Box over USB serial, view live temperature, humidity, pressure, and VOC readings, record timed sessions, and export data as CSV or JSON."
  }
}
