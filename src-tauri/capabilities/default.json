{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
  {
    "identifier": "fs:allow-write-text-file",
    "allow": [{ "path": "**" }]
  }
  ]
}
